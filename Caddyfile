{
    admin off
}

:80 {
    root * /srv
    encode gzip

    # Assets con hash en el nombre (Angular outputHashing: all) -> cache larga e inmutable
    @hashed {
        path_regexp \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$
    }
    header @hashed Cache-Control "public, max-age=31536000, immutable"

    # index.html no lleva hash: nunca debe cachearse, si no el navegador puede
    # quedarse con una versión vieja que apunta a bundles que ya no existen.
    # Se aplica a todo lo que no es un asset con hash, no solo a "/" e "/index.html":
    # las rutas de la SPA (/game/ABC123, /perfil...) también devuelven index.html por el
    # try_files de abajo y sin esta cabecera el navegador lo cacheaba.
    @index {
        not path_regexp \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$
    }
    header @index Cache-Control "no-cache, no-store, must-revalidate"

    # SPA fallback: cualquier ruta sin archivo real la resuelve Angular Router
    try_files {path} /index.html
    file_server
}
